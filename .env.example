# Environment Configuration
NODE_ENV=development
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/stableswap-ai

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API Keys
AIRSTACK_API_KEY=your-airstack-api-key
ALCHEMY_API_KEY=your-alchemy-api-key

# Turnkey/Privy Configuration (choose one)
TURNKEY_API_KEY=your-turnkey-api-key
TURNKEY_ORGANIZATION_ID=your-turnkey-org-id
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# OpenAI/Anthropic (optional for AI features)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Logging
LOG_LEVEL=info

# Payment Processing
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Cross-chain Bridge APIs
STARGATE_API_KEY=your-stargate-api-key
LAYERZERO_API_KEY=your-layerzero-api-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:5173
HELMET_CSP_ENABLED=true

# Monitoring
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-api-key
